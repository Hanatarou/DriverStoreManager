name: Build release

on:
  release:
    types: [published]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install Rust nightly
        run: rustup toolchain install nightly --profile minimal --component rust-src

      - name: Test
        run: cargo +nightly test

      - name: Build (smallest executable)
        env:
          RUSTFLAGS: -Zunstable-options -Cpanic=immediate-abort
        run: cargo +nightly build --release --target x86_64-pc-windows-msvc -Z build-std=std,panic_abort -Z build-std-features=optimize_for_size

      - name: Keep the executable as a build artifact
        uses: actions/upload-artifact@v4
        with:
          name: DriverStoreManager
          path: target/x86_64-pc-windows-msvc/release/DriverStoreManager.exe

      - name: Attach the executable to the release
        if: github.event_name == 'release'
        env:
          GH_TOKEN: ${{ github.token }}
        run: gh release upload "${{ github.event.release.tag_name }}" target/x86_64-pc-windows-msvc/release/DriverStoreManager.exe --clobber
