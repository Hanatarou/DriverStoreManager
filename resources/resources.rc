// Icon and version information of DriverStore Manager. Compiled by build.rs (rc.exe with MSVC, windres with MinGW).
// The constants are written out so the file needs no Windows SDK header.

1 ICON "icon.ico"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Bruno Eduardo"
            VALUE "FileDescription", "DriverStore Manager"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "DriverStoreManager"
            VALUE "LegalCopyright", "Copyright (c) 2026 Bruno Eduardo"
            VALUE "OriginalFilename", "DriverStoreManager.exe"
            VALUE "ProductName", "DriverStore Manager"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
